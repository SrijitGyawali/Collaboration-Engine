# Copy to .env for local runs. Values match deploy/docker-compose.yml.

LOG_LEVEL=info

# Service listen addresses
GATEWAY_ADDR=:8080
# Hosts whose pages may open WebSocket connections (comma-separated).
GATEWAY_ALLOWED_ORIGINS=localhost:3000
SYNC_HTTP_ADDR=:8081
SYNC_GRPC_ADDR=:9090
RELAY_HTTP_ADDR=:8082
WORKER_HTTP_ADDR=:8083

# Gateway -> sync service
SYNC_GRPC_TARGET=localhost:9090

# Infrastructure (local development only)
DATABASE_URL=postgres://collab:collab@localhost:15432/collab?sslmode=disable
REDIS_ADDR=localhost:16379
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=doc-events
