# The proxy in front of the gateways. Browsers connect here
# (ws://localhost:8080/ws); each WebSocket is handed to one gateway and stays
# on it until it closes. Any gateway can serve any document, because the
# gateways hear about each other's edits through Redis, so the proxy needs no
# sticky sessions.
{
	# Plain HTTP on a local port. In production TLS ends at the hosting
	# platform's edge, in front of this.
	auto_https off
	admin off
}

:8080 {
	reverse_proxy gateway-a:8080 gateway-b:8080 {
		# A WebSocket holds its gateway for minutes or hours, so balance on
		# open connections rather than taking turns.
		lb_policy least_conn

		# If the chosen gateway refuses the connection (it is restarting),
		# try the other one for a while instead of failing the handshake.
		lb_try_duration 5s
		lb_try_interval 250ms

		# Stop sending new connections to a gateway that stops answering.
		health_uri /healthz
		health_interval 2s
		health_timeout 2s
		fail_duration 10s
	}
}
